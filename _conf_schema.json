{
  "web_host": {
    "description": "HTTP/Web 控制台监听地址",
    "type": "string",
    "default": "0.0.0.0",
    "hint": "默认 0.0.0.0；如只允许本机反代访问可填 127.0.0.1"
  },
  "web_port": {
    "description": "HTTP/Web 控制台端口",
    "type": "int",
    "default": 5800
  },
  "api_token": {
    "description": "HTTP API Token（强烈建议填写）",
    "type": "string",
    "default": "",
    "hint": "米家或浏览器请求可使用 Header: X-Api-Token / Authorization: Bearer <token>，也可追加 ?token=<token>"
  },
  "allow_unsafe_without_token": {
    "description": "未配置 Token 时仍允许 HTTP 控制请求",
    "type": "bool",
    "default": false,
    "hint": "仅建议在完全可信的内网临时测试时开启"
  },
  "nas_ip": {
    "description": "NAS/跳板机 IP 地址",
    "type": "string",
    "default": "",
    "hint": "插件会先 SSH 到 NAS，再发送 WOL 或转发到 Windows"
  },
  "nas_user": {
    "description": "NAS SSH 用户名",
    "type": "string",
    "default": "root"
  },
  "nas_pass": {
    "description": "NAS SSH 密码",
    "type": "string",
    "default": ""
  },
  "nas_ssh_port": {
    "description": "NAS SSH 端口",
    "type": "int",
    "default": 22
  },
  "nas_target": {
    "description": "NAS 连通性测试 URL",
    "type": "string",
    "default": "",
    "hint": "例如 http://192.168.31.1 或你的健康检查地址"
  },
  "pc_ip": {
    "description": "目标 Windows 电脑 IP",
    "type": "string",
    "default": "",
    "obvious_hint": true
  },
  "pc_user": {
    "description": "Windows SSH 用户名",
    "type": "string",
    "default": ""
  },
  "pc_pass": {
    "description": "Windows SSH 密码",
    "type": "string",
    "default": ""
  },
  "pc_ssh_port": {
    "description": "Windows SSH 端口",
    "type": "int",
    "default": 22
  },
  "pc_mac": {
    "description": "目标电脑 MAC 地址（WOL 用）",
    "type": "string",
    "default": "",
    "hint": "如 AA:BB:CC:DD:EE:FF",
    "obvious_hint": true
  },
  "broadcast_ip": {
    "description": "WOL 广播地址",
    "type": "string",
    "default": "192.168.31.255",
    "hint": "根据局域网网段填写，例如 192.168.1.255"
  },
  "game_process": {
    "description": "状态检查时匹配的进程名",
    "type": "string",
    "default": "StarRail.exe"
  },
  "shutdown_delay": {
    "description": "Windows 关机延迟秒数",
    "type": "int",
    "default": 10
  }
}
